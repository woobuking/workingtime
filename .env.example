# Google Sheets 스프레드시트 ID
# URL에서 복사: https://docs.google.com/spreadsheets/d/[이 부분]/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# 기록할 시트(탭) 이름
SHEET_NAME=근무기록

# Google 서비스 계정 JSON 키 (한 줄로 변환해서 붙여넣기)
# GCP 콘솔 > IAM > 서비스 계정 > 키 만들기 > JSON 다운로드 후
# cat credentials.json | tr -d '\n' 으로 한 줄로 만들기
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"..."}

# 서버 포트 (기본값: 3000)
PORT=3000
